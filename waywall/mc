default partial alphanumeric_keys
xkb_symbols "basic" {
    name[Group1] = "Minecraft";


    key <TLDE> { [ U002D, U002D ] };                // 1 > -
    key <AE01> { [ b, B ] };                        // 1 > B
    key <AE02> { [ u, U ] };                        // 2 > U
    key <AE03> { [ i, I ] };                        // 3 > I
    key <AE04> { [ e, E ] };                        // 4 > E
    key <AE05> { [ p, P ] };                        // 5 > P
    key <AE10> { [ 0, 0 ] };                        // 0 > 0


    key <AD01> { [ d, D ] };                        // Q > D
    key <AD02> { [ h, H ] };                        // W > W
    key <AD03> { [ o, O ] };                        // E > E
    key <AD04> { [ a, A ] };                        // R > A
    key <AC08> { [ t, T ] };                        // T > T (K)


    key <CAPS> { [ r, R ] };                        // CAPS > r
    key <AC09> { [ n , N ] };                       // A > N (L)
    key <AC02> { [ s, S ] };                        // S > S
    key <AC03> { [ v, V ] };                        // D > V
    key <AC04> { [ oslash, Ooblique ] };            // E > E


    // SKIP Z
    key <AB02> { [ 8 , 8 ] };                       // X > 8
    // SKIP C
    key <AB04> { [ 6 , 6 ] };                       // 6 > 6

};